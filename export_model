"""
Train once (Colab / your PC), save everything the Space needs into model_bundle.joblib.

    python export_model.py --data_root "/content/Vowels&Consonants" \
        --algo spectral --k 31 --pca_dim 100 --out model_bundle.joblib

Needs cluster.py in the same folder. No labels are used for clustering; they are
only used afterwards to name each cluster (Hungarian matching) and for metrics.
"""
import argparse
import os

import joblib
import numpy as np
from sklearn.decomposition import PCA
from sklearn.neighbors import KNeighborsClassifier
from sklearn.preprocessing import StandardScaler

import cluster as C

ALGOS = {
    "kmeans": lambda X, k, s: C.run_kmeans(X, k, seed=s),
    "minibatchkmeans": lambda X, k, s: C.run_minibatch_kmeans(X, k, seed=s),
    "bisecting_kmeans": lambda X, k, s: C.run_bisecting_kmeans(X, k, seed=s),
    "gmm": lambda X, k, s: C.run_gmm(X, k, seed=s),
    "em": lambda X, k, s: C.run_em(X, k, seed=s),
    "agglomerative": lambda X, k, s: C.run_agglomerative(X, k),
    "birch": lambda X, k, s: C.run_birch(X, k),
    "spectral": lambda X, k, s: C.run_spectral(X, k, seed=s),
}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--data_root", required=True)
    ap.add_argument("--algo", choices=list(ALGOS), default="spectral")
    ap.add_argument("--features", choices=["hog", "pixel"], default="hog")
    ap.add_argument("--k", type=int, default=31)
    ap.add_argument("--pca_dim", type=int, default=100)
    ap.add_argument("--seed", type=int, default=0)
    ap.add_argument("--samples_per_cluster", type=int, default=16)
    ap.add_argument("--knn", type=int, default=15)
    ap.add_argument("--out", default="model_bundle.joblib")
    a = ap.parse_args()

    print("[1/5] loading data ...")
    imgs, y, class_names = C.load_dataset(a.data_root)
    imgs = C.binarize_and_center(imgs)
    print(f"      {len(imgs)} images, {len(class_names)} classes")

    print("[2/5] features + scaler + PCA ...")
    feat = C.extract_hog_features if a.features == "hog" else C.extract_pixel_features
    X_raw = feat(imgs)
    scaler = StandardScaler().fit(X_raw)
    Xs = scaler.transform(X_raw)
    pca = PCA(n_components=min(a.pca_dim, Xs.shape[1], Xs.shape[0] - 1),
              random_state=a.seed).fit(Xs)
    X = pca.transform(Xs)

    print(f"[3/5] clustering with {a.algo} (k={a.k}) ...")
    pred = ALGOS[a.algo](X, a.k, a.seed)
    metrics, mapping = C.evaluate(y, pred, X_for_silhouette=X, seed=a.seed)
    print("      ", {m: round(float(v), 4) for m, v in metrics.items()})

    print("[4/5] fitting kNN assigner + cluster names + sample images ...")
    # New characters are assigned by majority vote of their nearest training
    # points in PCA space. This follows the clustering (works for spectral too,
    # which has no centroids).
    knn = KNeighborsClassifier(n_neighbors=a.knn).fit(X, pred)
    cids = np.unique(pred)
    cluster_to_class = {int(c): class_names[mapping[c]] if c in mapping else "?" for c in cids}
    rng = np.random.RandomState(a.seed)
    samples = {}
    for c in cids:
        idx = np.where(pred == c)[0]
        idx = rng.choice(idx, min(a.samples_per_cluster, len(idx)), replace=False)
        samples[int(c)] = (imgs[idx] * 255).astype(np.uint8)

    tsne_png = os.path.splitext(a.out)[0] + "_tsne.png"
    C.plot_tsne(X, y, pred, tsne_png, seed=a.seed)

    print("[5/5] saving ...")
    joblib.dump(dict(
        features=a.features, algo=a.algo, k=a.k, pca_dim=int(pca.n_components_),
        scaler=scaler, pca=pca, knn=knn, cids=cids,
        cluster_to_class=cluster_to_class, samples=samples,
        metrics={m: float(v) for m, v in metrics.items()},
        n_images=int(len(imgs)), class_names=class_names,
    ), a.out, compress=3)
    print(f"done -> {a.out} ({os.path.getsize(a.out)/1e6:.1f} MB) and {tsne_png}")


if __name__ == "__main__":
    main()
